# PostgreSQL (Coolify: point at your PostgreSQL resource)
DATABASE_URL=postgres://kenni:kenni@localhost:5432/kenni

# APNs — token-based auth key from developer.apple.com (Keys → create with APNs).
# Paste the full .p8 file content including BEGIN/END lines.
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=RKJ58337K2
APNS_TOPIC=ch.benavo.kenni
# development | production (matches the app build you're pushing to)
APNS_ENV=development

# Approved-business admin. Admin stays locked unless both are set.
# Keep BUSINESS_PIN_SECRET stable: it keys the stored PIN digests.
ADMIN_PSK=
BUSINESS_PIN_SECRET=

# Per-IP requests per minute (default 120; /health is exempt)
RATE_LIMIT=120
