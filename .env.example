# PostgreSQL (Coolify: point at your PostgreSQL resource)
DATABASE_URL=postgres://kenni:kenni@localhost:5432/kenni

# Public base URL of this API — used for SSO redirects and logo links.
PUBLIC_BASE_URL=https://kenniapi.benavo.ch

# APNs — token-based auth key from developer.apple.com (Keys → create with APNs).
# Paste the full .p8 file content including BEGIN/END lines. Both the sandbox and
# the production endpoint are used; each app registration says which it needs.
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=RKJ58337K2
APNS_TOPIC=ch.benavo.kenni
# Default for registrations from app versions that don't say (≤ 1.0.2).
APNS_ENV=production

# Approved-business admin. The portal stays locked without BUSINESS_TOKEN_SECRET;
# the KENNI super-admin sign-in additionally needs ADMIN_PSK.
# Keep BUSINESS_TOKEN_SECRET stable: it authenticates enrollment links and PINs
# and encrypts stored SSO client secrets.
ADMIN_PSK=
BUSINESS_TOKEN_SECRET=
# Second factor for the super-admin: `swift run App admin-totp-secret`
ADMIN_TOTP_SECRET=

# Which proxies may set X-Forwarded-For (see README → "Client IPs"):
#   unset → loopback + private networks (Coolify's Traefik)
#   2     → exactly two proxies in front (e.g. a CDN + Traefik)
#   CIDRs → comma-separated ranges plus `loopback` / `private`
#   none  → ignore the header
TRUST_PROXY=

# Rate limits (per minute)
RATE_LIMIT=300
RATE_LIMIT_PER_KEY=120
# Wrong business PINs accepted across all clients per 10 minutes
PIN_FAILURE_BUDGET=300

# v1 request signatures from app versions ≤ 1.0.2. Set to false once they're gone.
ACCEPT_LEGACY_SIGNATURES=true

# Several replicas: set false and run `App migrate --yes` once per deploy.
AUTO_MIGRATE=true

# Optional: /metrics in Prometheus format, scraped with `Authorization: Bearer <token>`
METRICS_TOKEN=
# Optional: one JSON object per log line
LOG_FORMAT=
